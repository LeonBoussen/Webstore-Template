# Copy this file to `.env` in the `back/` directory and fill in real values.
# The backend refuses to start without SECRET_KEY and MAX_UPLOAD_MB.

# Secret used to sign authentication tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Maximum image upload size, in megabytes.
MAX_UPLOAD_MB=10

# Comma-separated list of origins allowed to call this API (CORS allow-list).
# Defaults to the local Vite dev server when unset.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Legacy migration only: username that is auto-promoted to the admin role
# when starting on a database created before roles existed. New installs get
# a temporary admin/admin account seeded on first launch instead — see README.
ADMIN_USERNAME=LeonBoussen

# Set to 1 to enable the hard-coded development discount codes
# (DEV10 / STUDENT15 / SAVE5). Keep 0 in production.
ENABLE_DEV_DISCOUNT_CODES=0

# --- PayPal (optional) ------------------------------------------------------
# Leave empty to disable PayPal. The checkout page will report that PayPal is
# not configured when these are blank.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox     # "sandbox" or "live"
CURRENCY=EUR           # three-letter ISO currency code

# Legacy variable. It is read at startup but not used by the admin
# authorization check (admin access is based on the account role).
ADMIN_PASSWORD=
